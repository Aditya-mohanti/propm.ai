# ── Google sign-in (required to reach the workspace) ─────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type:        Web application
#   Authorised redirect URI: http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Signs the session cookie. Required in production; development falls back to
# a fixed insecure string. Generate one with: openssl rand -base64 32
# AUTH_SECRET=

# ── Contact ─────────────────────────────────────────────────────────────
# Where the header's "Any queries?" form sends. Kept out of source so the
# address is not in the repo; note it is still inlined into the client bundle,
# so it is visible to anyone reading the deployed page's JavaScript.
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# ── AI provider (optional) ──────────────────────────────────────────────
# Either set a key here, or connect a provider from the workspace UI. To run
# chats on your own Claude subscription instead, run `ant auth login` and pick
# "Use my Claude account" in the connect dialog.
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...
